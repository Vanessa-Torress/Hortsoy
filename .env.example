# ── Configurações Next.js (Client-side = NEXT_PUBLIC_*) ─────────────────────

# Configurações do WhatsApp
NEXT_PUBLIC_WHATSAPP_PHONE=SEU_NUMERO_WHATSAPP
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Olá! Gostaria de saber mais sobre as soluções da Hortsoy.

# ── Conteúdo Institucional do Footer ──────────────────────────────────────────
# Slogan: formato "texto|destaque|texto|destaque" (partes ímpares recebem cor de destaque)
NEXT_PUBLIC_FOOTER_SLOGAN=Inovação e sustentabilidade |para o futuro| do seu agronegócio

# Endereço Corporativo
NEXT_PUBLIC_FOOTER_ADDRESS="Avenida Santos Dumont, 130\nUberaba - MG | CEP: 38050-400"

# Redes Sociais
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/hortsoy/
NEXT_PUBLIC_LINKEDIN_URL=https://br.linkedin.com/company/grupo-hortsoy
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/Hortsoy/
